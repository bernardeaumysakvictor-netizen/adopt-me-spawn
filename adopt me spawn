            print("4. 🤝 Start Visual Trade")
            print("5. 💰 Calculate Total Value")
            print("6. 🎯 Filter by Rarity")
            print("7. 🚪 Exit")
            print(string.rep("=", 60))
            
            io.write("Choose an option (1-7): ")
            local choice = io.read()
            
            if choice == "1" then
                spawnAllPets()
            elseif choice == "2" then
                displayInventory()
            elseif choice == "3" then
                displayInventory("high_tier")
            elseif choice == "4" then
                startTrade()
            elseif choice == "5" then
                local total = 0
                for _, pet in ipairs(playerInventory.pets) do
                    total = total + pet.final_value
                end
                print(string.format("\nTotal Inventory Value: %,d", total))
            elseif choice == "6" then
                print("Enter rarity (common/uncommon/rare/ultra_rare/legendary/high_tier): ")
                local rarity = io.read()
                displayInventory(rarity)
            elseif choice == "7" then
                print("Thanks for learning advanced Lua programming!")
                break
            else
                print("Invalid option!")
            end
        end
    end
end

