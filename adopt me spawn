-- Potion types and their value multipliers
local potionTypes = {
    ["No Potion"] = {fly = false, ride = false, multiplier = 1.0},
    ["Fly"] = {fly = true, ride = false, multiplier = 1.5},
    ["Ride"] = {fly = false, ride = true, multiplier = 1.5},
